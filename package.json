{
  "name": "hello-hermes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-content.mjs && vitepress build docs && node scripts/check-public-output.mjs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "check": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync:check": "node scripts/check-upstream.mjs",
    "review": "node scripts/review.mjs start",
    "review:list": "node scripts/review.mjs list",
    "review:test:browser": "node tests/review-browser.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.22"
  }
}
